# =============================================================
# Prime Tours — environment template
# Copy to .env and fill in. NEVER commit .env.
# Deployment credentials live in GitHub Secrets, not here.
# =============================================================

# --- Content pipeline: pushing drafts to WordPress ------------
# Application Password from WP Admin → Users → Profile.
# Use the STAGING site until cutover.
WP_SITE_URL=https://staging.primetours.co.za
WP_USERNAME=andrew
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Affiliate programme IDs ----------------------------------
# Not secrets — these appear in every outbound link. Full programme
# reference, link format and conventions: affiliates.md
VIATOR_PARTNER_ID=P00148357
VIATOR_MCID=
GYG_PARTNER_ID=2ANVBLS

# --- Analytics ------------------------------------------------
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=


# =============================================================
# GitHub Secrets required for deployment (set in repo settings,
# NOT in this file):
#
#   SSH_HOST            Hostinger server hostname
#   SSH_PORT            usually 65002 on Hostinger
#   SSH_USER            Hostinger SSH username
#   SSH_PRIVATE_KEY     deploy key private half
#   STAGING_PATH        absolute path to staging webroot
#   PRODUCTION_PATH     absolute path to production webroot
# =============================================================
